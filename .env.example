# OCI Object Storage via the S3-compatible API. Copy to .env (gitignored) and fill in.
# Namespace: Tenancy details page (or `oci os ns get`).
# Keys: Identity -> My Profile -> Customer Secret Keys -> Generate Secret Key.
OCI_NAMESPACE=
OCI_REGION=us-ashburn-1
OCI_BUCKET=ml-models
OCI_S3_ACCESS_KEY_ID=
OCI_S3_SECRET_ACCESS_KEY=
# Optional: override the derived https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# OCI_S3_ENDPOINT=
