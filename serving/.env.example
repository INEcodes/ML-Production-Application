# Lives next to docker-compose.yml as .env (on the VM: /opt/ml-app/.env). Never commit it.

# Image in OCIR: <region>.ocir.io/<tenancy-namespace>/<repo>. deploy.sh rewrites IMAGE_TAG.
IMAGE=us-ashburn-1.ocir.io/<tenancy-namespace>/ml-serving
IMAGE_TAG=latest

# Which model services run. Only list models that have a version pushed to the bucket.
COMPOSE_PROFILES=cnn,rnn

# Model pins: "latest" (follows latest.json) or a number like 3. Change + `docker compose up -d` to roll back.
CNN_MODEL_VERSION=latest
RNN_MODEL_VERSION=latest

# OCI Object Storage, S3-compatible API. Ideally a key for a user that can only READ the bucket.
OCI_NAMESPACE=
OCI_REGION=us-ashburn-1
OCI_BUCKET=ml-models
OCI_S3_ACCESS_KEY_ID=
OCI_S3_SECRET_ACCESS_KEY=

LOG_LEVEL=INFO
