# In production this is set in Vercel: Project → Settings → Environment Variables.
# For local `npm run dev`, copy to frontend/.env (gitignored); Vite proxies /api/* to it.
API_BASE_URL=https://92-4-71-81.sslip.io/cnn
# Same value as PROXY_KEY on the VM (scripts/vm/setup.sh); nginx rejects requests without it.
PROXY_KEY=
# Vercel only (optional): comma-separated browser origins the /api function accepts.
# ALLOWED_ORIGINS=https://ml-production-application-frontend.vercel.app
